# Dependencies
node_modules/

# Environment variables
.env
.env.local

# SQLite database files
*.db
*.db-shm
*.db-wal
*.sqlite

# macOS
.DS_Store

# Logs
logs/
*.log
npm-debug.log*

# Build output
dist/
dist-*/
build/

# Uploaded files (server-side only)
uploads/

# Local database backups (do not commit)
*_backup_*.sql
*.sql.gz

# Runtime outputs
test-results/
playwright-report/
.playwright-cli/
.playwright-mcp/
.claude/worktrees/
tasks/todo.md

# Local generated backup/archive artifacts
apps/**/backend/scripts/cleanup-backups/
apps/**/backend/scripts/novartis-full-scope-backups/

# Runtime storage/data artifacts
apps/**/backend/storage/email_attachments/
apps/**/backend/storage/org_logos/
apps/**/backend/storage/cm_documents/**
!apps/**/backend/storage/cm_documents/.gitkeep
apps/**/backend/storage/documents/**
!apps/**/backend/storage/documents/.gitkeep

# Generated deliverables / exports
outputs/
output/
apps/**/frontend/design-screenshots/

# PM2 ecosystem config — the repo holds the template at ops/pm2/ecosystem.config.js.
# A deployed box keeps its own edited copy outside the repo; nothing here overwrites it.
# The earlier rule listed the file as ignored while it was already tracked, which does
# nothing — an ignore rule cannot un-track a file. Removed 2026-09-24 rather than left
# to read as a control that was never in force.
ecosystem.config.local.js

# WP9: never commit DB dumps (e.g. mims_dev_backup_*.sql)
*.sql
# ...but schema migrations ARE source and must be committed. The blanket rule
# above had silently swallowed CP Portal migrations 0002-0010 — a fresh clone
# could not build the schema past 0001. Found 2026-08-04 while adding 0011.
!**/migrations/*.sql
!**/migrations/**/*.sql

# Test console run artifacts (registry.json IS committed — it is the corpus)
.e2e-stack/
