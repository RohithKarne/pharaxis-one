# ─── Base44 dev defaults (placeholders) ───────────────────────────────────────
# Loaded FIRST by docker-compose.base44.yml; real secrets in /run/base44/app.env
# (platform-managed) always override these. Values here are dev-only placeholders.
# Local-infra credentials (MySQL/Redis) are NOT here — they are inline in compose.

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=
MIMS_ALLOWED_FRONTEND_ORIGINS=

# ─── Bootstrap platform admin (first-run migration creates this account) ─────
# Login at /mims/login with this email + password.
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@pharaxis.local
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=Pharaxis@Dev2026

# ─── JWT + SSO config encryption (stable across restarts so sessions survive) ─
JWT_SECRET=bbba09692c8020631feab815895d59c1dc116624298cfed6ace069d82dc11f0c
SSO_CONFIG_ENCRYPTION_KEY=189026979106e86b28a7b7be87148de9d8330bbefd58b068b9a6496e7d4dbb61

# ─── Frontend/backend base URLs (dev) ─────────────────────────────────────────
MIMS_FRONTEND_BASE_URL=http://localhost:5173/mims
MIMS_BACKEND_BASE_URL=http://localhost:3000

# ─── Email / SMTP (optional — email poller degrades gracefully without it) ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=dev_placeholder_smtp_password

# ─── Process explorer full-view emails ────────────────────────────────────────
PROCESS_EXPLORER_FULL_VIEW_EMAILS=admin@pharaxis.local
