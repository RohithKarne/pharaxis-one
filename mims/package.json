{
  "name": "mims",
  "version": "1.0.0",
  "description": "Medical Information Management System - Inquiry handling and case processing platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:all": "concurrently -n backend,frontend -c cyan,magenta \"nodemon backend/server.js\" \"cd frontend && npm run dev\"",
    "test": "jest --testPathPattern=backend/tests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "imap": "^0.8.19",
    "imapflow": "^1.2.13",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.4",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.1.2",
    "jest": "^30.3.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2"
  }
}
