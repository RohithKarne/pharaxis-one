# Server
PORT=5100
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://13.205.213.128,https://13.205.213.128
INPUT_JSON_LIMIT=1mb
INPUT_URLENCODED_LIMIT=1mb
INPUT_PARAM_LIMIT=1000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass
MYSQL_DATABASE=pharaxis_vault_dev

# JWT
JWT_SECRET=
SUPERADMIN_JWT_SECRET=
SUPERADMIN_MFA_MODE=off
MFA_CHALLENGE_TTL_MINUTES=10

# AWS S3 / MinIO
S3_BUCKET=pharaxis-vault-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_ENDPOINT=http://localhost:9000

# Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WORKFLOW_NOTIFICATION_FROM=vault-workflow@pharaxis.local
WORKFLOW_WEBHOOK_TIMEOUT_MS=4000

# Integration Connector Health Tests
CONNECTOR_TEST_MODE=live
CONNECTOR_TEST_TIMEOUT_MS=4000
