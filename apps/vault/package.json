{
  "name": "pharaxis-vault-backend",
  "version": "1.0.0",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:all": "concurrently -n backend,frontend -c cyan,magenta \"nodemon backend/server.js\" \"cd frontend && npm run dev\"",
    "dev:clean": "bash ./dev-clean.sh",
    "stop:ports": "bash ./stop-ports.sh",
    "build": "cd frontend && npm run build",
    "db:migrate": "node backend/scripts/run-migrations.js",
    "security:scan": "bash ./scripts/security-scan.sh",
    "test": "npm run test:static",
    "test:static": "node backend/tests/syntax-check.js",
    "test:smoke": "node backend/tests/smoke-health.js",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:ui": "playwright test --config=playwright.config.js --ui",
    "seed:phase3": "node backend/tests/seed-phase3.js",
    "test:smoke:sprint1": "node backend/tests/smoke-sprint1.js",
    "test:smoke:phase3": "node backend/tests/smoke-phase3.js",
    "test:smoke:phase4": "node backend/tests/smoke-phase4.js",
    "test:smoke:oneshot": "node backend/tests/smoke-oneshot.js",
    "test:sprint-close:gate1": "npm run test:static && npm run build && npm run security:scan && npm run test:smoke && npm run test:e2e -- --grep \"Vault smoke\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1039.0",
    "bcrypt": "^6.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "nodemon": "^3.0.2"
  }
}
