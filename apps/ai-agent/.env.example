# AI-Agent Backend
NODE_ENV=development
PORT=6000
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://13.205.213.128,https://13.205.213.128
INPUT_JSON_LIMIT=1mb
INPUT_URLENCODED_LIMIT=1mb
INPUT_PARAM_LIMIT=1000
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=180

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass
MYSQL_DATABASE=pharaxis_ai_agent_dev

# Encryption key for stored provider API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_AGENT_ENCRYPTION_KEY=replace_with_64_hex_chars
JWT_SECRET=replace_with_long_random_secret

# Internal service-to-service auth (backend/middleware/internalAuth.js)
# REQUIRED: set exactly one of the two below, or the backend throws at boot.
# Prefer the JWT secret; it carries an orgId claim. The shared token is the
# legacy fallback and requires callers to send an X-Org-Id header.
# If both are set, the JWT secret wins and the shared token is ignored.
# Generate either with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_AGENT_INTERNAL_JWT_SECRET=replace_with_long_random_secret
# AI_AGENT_INTERNAL_TOKEN=replace_with_long_random_secret

# Superadmin static-token bypass (backend/middleware/auth.js)
# Optional dev-only shortcut. Leave the flag false in any shared environment so
# superadmin routes only accept a JWT_SECRET-signed token with role=superadmin.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_AGENT_ENABLE_SUPERADMIN_STATIC_TOKEN=false
AI_AGENT_SUPERADMIN_TOKEN=replace_with_long_random_secret
