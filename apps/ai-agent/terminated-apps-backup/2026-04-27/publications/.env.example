# Publications Backend
PORT=5310
JWT_SECRET=publications_local_dev_secret_change_me

# MySQL only (do not use PostgreSQL)
DATABASE_URL=mysql://devuser:devpass@127.0.0.1:3306/pharaxis_publications_dev

# Default bootstrap super admin
DEFAULT_SUPERADMIN_EMAIL=superadmin.publications@pharaxis.one
DEFAULT_SUPERADMIN_PASSWORD=Admin@123

# App URL used in invite/reset links
PUBLICATIONS_APP_BASE_URL=http://127.0.0.1:5179

# Token expiry controls
INVITE_TOKEN_HOURS=72
RESET_TOKEN_HOURS=2

# Optional SMTP (leave blank to use JSON transport in local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=no-reply@pharaxis.one

# Max document upload size (default 50MB)
PUBLICATIONS_MAX_UPLOAD_BYTES=52428800

# Overdue milestone scan interval (minutes). 1440 = daily.
MILESTONE_OVERDUE_SCAN_MINUTES=1440
