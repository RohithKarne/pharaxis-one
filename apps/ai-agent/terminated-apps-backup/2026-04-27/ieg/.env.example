PORT=5300
NODE_ENV=development
JWT_SECRET=ieg_dev_secret_change_me
JWT_EXPIRES_IN=8h
DATABASE_URL=mysql://devuser:devpass@127.0.0.1:3306/pharaxis_ieg_dev
DEFAULT_SUPERADMIN_EMAIL=superadmin.ieg@pharaxis.one
DEFAULT_SUPERADMIN_PASSWORD=Admin@123
UPLOAD_ROOT=./backend/storage
PUBLIC_APP_URL=http://127.0.0.1:5178
EMAIL_PROVIDER=console
EMAIL_FROM=ieg-noreply@pharaxis.one

# Integration transport
INTEGRATION_HTTP_TIMEOUT_MS=15000
INTEGRATION_CONFIG_SECRET_KEY=replace_with_strong_random_secret

# Veeva Vault integration
VEEVA_INTEGRATION_ENABLED=false
VEEVA_BASE_URL=
VEEVA_SYNC_PATH=/api/v1/ieg/sync
VEEVA_ACCESS_TOKEN=
VEEVA_TOKEN_URL=
VEEVA_CLIENT_ID=
VEEVA_CLIENT_SECRET=
VEEVA_GRANT_TYPE=client_credentials
VEEVA_SCOPE=

# SharePoint / Microsoft Graph integration
SHAREPOINT_INTEGRATION_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SCOPE=https://graph.microsoft.com/.default
MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_PATH=IEG-Sync

# ClinicalTrials.gov live fetch
CTG_LIVE_FETCH_ENABLED=false
CTG_API_BASE_URL=https://clinicaltrials.gov/api/v2/studies

# ERP export delivery
ERP_EXPORT_DELIVERY_ENABLED=false
ERP_EXPORT_ENDPOINT_URL=
ERP_EXPORT_AUTH_TOKEN=
ERP_EXPORT_ALLOW_HTTP=false

# LLM (OpenAI Responses API)
LLM_LIVE_ENABLED=false
LLM_REQUIRE_LIVE=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
