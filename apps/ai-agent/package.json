{
  "name": "pharaxis-ai-agent",
  "version": "1.0.0",
  "main": "backend/server.js",
  "scripts": {
    "db:migrate": "node backend/database/migrate.js",
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "dev:all": "concurrently -n backend,frontend -c cyan,magenta \"nodemon backend/server.js\" \"cd frontend && npm run dev\"",
    "build": "cd frontend && npm run build",
    "security:scan": "bash ./scripts/security-scan.sh",
    "test": "npm run test:static",
    "test:static": "node backend/tests/syntax-check.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.2.0",
    "bcrypt": "^6.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.0",
    "openai": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "nodemon": "^3.0.2"
  }
}
