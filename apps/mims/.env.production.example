# .env.production.example — reference only
# All UAT env vars are now set directly in ecosystem.config.local.js
# Edit that file instead of creating a separate .env for the UAT server.
#
# This file documents every available variable and its purpose.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass
MYSQL_DATABASE=pharaxis_mims_uat

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_32_chars_min
SESSION_CACHE_TTL_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
MIMS_FRONTEND_BASE_URL=http://localhost:4001/mims
MIMS_BACKEND_BASE_URL=http://localhost:4001
MIMS_ALLOWED_FRONTEND_ORIGINS=http://localhost:4001,http://127.0.0.1:4001

# ── Email (SMTP for outbound MI emails) ──────────────────────────────────────
SMTP_CONNECT_TIMEOUT_MS=15000

# ── IMAP polling timeouts ─────────────────────────────────────────────────────
IMAP_CONNECT_TIMEOUT_MS=10000
IMAP_SOCKET_TIMEOUT_MS=30000

# ── Email worker ──────────────────────────────────────────────────────────────
EMAIL_WORKER_POLL_MS=15000
EMAIL_WORKER_BATCH_SIZE=5

# ── Worker cache TTL ─────────────────────────────────────────────────────────
WORKFLOW_CACHE_TTL_SECONDS=300

# ── Multi-org UAT simulation ──────────────────────────────────────────────────
# Comma-separated org IDs to simulate alongside Novartis-Demo (org 1).
# Leave empty to skip. Org must be fully seeded first.
EXTRA_DEMO_ORG_IDS=

# ── Misc ──────────────────────────────────────────────────────────────────────
INPUT_JSON_LIMIT=1mb
