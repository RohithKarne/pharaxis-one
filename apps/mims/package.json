{
  "name": "mims",
  "version": "1.0.0",
  "description": "Medical Information Management System - Inquiry handling and case processing platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon --exec \"node --env-file=.env\" backend/server.js",
    "dev:all": "concurrently -n backend,frontend -c cyan,magenta \"nodemon --exec 'node --env-file=.env' backend/server.js\" \"cd frontend && npm run dev\"",
    "dev:clean": "bash ./dev-clean.sh",
    "stop:ports": "bash ./stop-ports.sh",
    "security:scan": "bash ./scripts/security-scan.sh",
    "test:static": "node backend/tests/syntax-check.js",
    "test": "jest --testPathPatterns=backend/tests --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke:sprint14:g12": "node backend/tests/smoke-sprint14-g12.js",
    "test:sprint-close:gate1": "npm run test:smoke:sprint14:g12 && npm run test:e2e",
    "test:smoke:sprint14:g13": "node backend/tests/smoke-sprint14-g13.js",
    "demo:preflight": "node backend/tests/smoke-sprint14-g13.js",
    "test:sprint14:full": "npm run test:smoke:sprint14:g12 && npm run test:smoke:sprint14:g13"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "geoip-lite": "^2.0.3",
    "imapflow": "^2.11.0",
    "ioredis": "^6.0.0",
    "joi": "^18.3.2",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.14.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.2",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/geoip-lite": "^1.4.4",
    "concurrently": "^10.0.7",
    "jest": "^30.3.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.3.2"
  }
}
