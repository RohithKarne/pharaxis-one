{
  "_comment": [
    "The cumulative regression corpus. Every suite the team has written stays here",
    "permanently, tagged with the release that contributed it. Nothing is removed",
    "when a release ships \u2014 that is what makes a full regression run meaningful at",
    "any point in the testing phase.",
    "",
    "Suites enter this file by promotion: a release run finishes clean, and its new",
    "suites are appended with the release tag. Adding a suite by hand is allowed but",
    "should be rare \u2014 the promotion flow is the intended path."
  ],
  "releases": [
    "Sprint 14",
    "Sprint 16",
    "Sprint 17",
    "Sprint 18",
    "Sprint 19",
    "Sprint 20",
    "Sprint 21",
    "2026.07-R1",
    "2026.07-R2",
    "2026.07-R3",
    "2026.07-R4"
  ],
  "apps": [
    {
      "id": "mims",
      "name": "MIMS",
      "cwd": "apps/mims",
      "env": {
        "MYSQL_DATABASE": "pharaxis_mims_test"
      },
      "suites": [
        {
          "id": "mims-unit-backend",
          "name": "backend unit (jest)",
          "tier": 1,
          "addedIn": "Sprint 14",
          "cmd": "npx jest --testPathPatterns=backend/tests --forceExit --verbose",
          "parser": "jest"
        },
        {
          "id": "mims-unit-frontend",
          "name": "frontend unit (vitest)",
          "tier": 1,
          "addedIn": "Sprint 18",
