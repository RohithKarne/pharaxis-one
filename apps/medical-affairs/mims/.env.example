# ─── MIMS Backend — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values before starting the server.
# Never commit the actual .env file to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mims_user
MYSQL_PASSWORD=your_db_password_here
MYSQL_DATABASE=pharaxis_mims_dev

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long, random secret. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Maximum upload file size in megabytes (default: 10)
UPLOAD_MAX_SIZE_MB=10

# ─── Process Explorer ─────────────────────────────────────────────────────────
# Comma-separated list of email addresses that can see the full process explorer view
PROCESS_EXPLORER_FULL_VIEW_EMAILS=admin@example.com,dev@example.com
