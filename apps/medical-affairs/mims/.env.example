# ─── MIMS Backend — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values before starting the server.
# Never commit the actual .env file to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mims_user
MYSQL_PASSWORD=your_db_password_here
MYSQL_DATABASE=pharaxis_mims_dev

# Used only when DB is empty and superadmin must be bootstrapped
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=replace_with_strong_bootstrap_password

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long, random secret. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here

# ─── File Uploads ─────────────────────────────────────────────────────────────
# Maximum upload file size in megabytes (default: 10)
UPLOAD_MAX_SIZE_MB=10
UPLOAD_MAX_FILES=10

# ─── Input Security / Validation ──────────────────────────────────────────────
INPUT_JSON_LIMIT=1mb
INPUT_URLENCODED_LIMIT=1mb
INPUT_PARAM_LIMIT=2000
INPUT_MAX_DEPTH=8
INPUT_MAX_ARRAY_ITEMS=500
INPUT_MAX_OBJECT_KEYS=200
INPUT_MAX_QUERY_STRING=2048
INPUT_MAX_PARAM_STRING=1024
INPUT_MAX_BODY_STRING=250000

# ─── Process Explorer ─────────────────────────────────────────────────────────
# Comma-separated list of email addresses that can see the full process explorer view
PROCESS_EXPLORER_FULL_VIEW_EMAILS=admin@example.com,dev@example.com

# ─── Regression Runner Credentials ────────────────────────────────────────────
# Used by backend/services/regressionRunner.js for test login token acquisition
REGRESSION_EMAIL=regression@system
REGRESSION_PASSWORD=replace_with_regression_user_password
REGRESSION_FALLBACK_EMAIL=superadmin
REGRESSION_FALLBACK_PASSWORD=replace_with_fallback_password
