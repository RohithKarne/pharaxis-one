# CP Portal Backend
CP_PORT=4000
NODE_ENV=development

# CORS
CP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://13.205.213.128,https://13.205.213.128

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=devuser
MYSQL_PASSWORD=devpass
MYSQL_DATABASE=pharaxis_cp_portal_dev

# Auth Secrets (replace in non-local environments)
CP_ADMIN_JWT_SECRET=replace_with_long_random_secret
CP_PORTAL_JWT_SECRET=replace_with_long_random_secret
JWT_SECRET=replace_with_long_random_secret

# Used only when the database is empty and the superadmin must be created.
# Seeding throws without it, so a fresh checkout cannot start until it is set.
# Added 2026-09-14: it was required by the code and missing from this file.
CP_BOOTSTRAP_SUPERADMIN_PASSWORD=replace_with_strong_bootstrap_password

# Secret-at-rest encryption key — encrypts SMTP passwords and integration/chatbox
# API keys stored in MySQL. REQUIRED in production (server refuses to encrypt without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CP_SECRET_ENCRYPTION_KEY=replace_with_64_hex_chars
