# Pharaxis One nginx path-based production template
# Replace __DOMAIN__ with the real production host before enabling.
# Static frontend roots expected under /var/www/pharaxis/<app>/
# Backends expected on localhost via PM2.

upstream vault_backend {
    server 127.0.0.1:5100;
    keepalive 32;
}

upstream qms_backend {
    server 127.0.0.1:3145;
    keepalive 32;
}

upstream cp_portal_backend {
    server 127.0.0.1:4000;
    keepalive 32;
}

upstream mims_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream ai_agent_backend {
    server 127.0.0.1:6000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location /vault/api/ {
        proxy_pass http://vault_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /qms/api/ {
        proxy_pass http://qms_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /cp-portal/api/ {
        proxy_pass http://cp_portal_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mims/api/ {
        proxy_pass http://mims_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ai-agent/api/ {
        proxy_http_version 1.1;
        proxy_pass http://ai_agent_backend/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ai-agent/ {
        root /var/www/pharaxis;
        try_files $uri $uri/ /ai-agent/index.html;
    }

    location /vault/ {
        root /var/www/pharaxis;
        try_files $uri $uri/ /vault/index.html;
    }

    location /qms/ {
        root /var/www/pharaxis;
        try_files $uri $uri/ /qms/index.html;
    }

    location /cp-portal/ {
        root /var/www/pharaxis;
        try_files $uri $uri/ /cp-portal/index.html;
    }

    location /mims/ {
        root /var/www/pharaxis;
        try_files $uri $uri/ /mims/index.html;
    }

    location / {
        return 302 /cp-portal/;
    }
}
